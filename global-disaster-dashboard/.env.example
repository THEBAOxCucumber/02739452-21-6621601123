# Copy to .env and replace every "change_me" value. Never commit .env.
POSTGRES_USER=disaster_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=disaster_db
# Host port for PostgreSQL (change if 5432 is already used on your machine)
POSTGRES_HOST_PORT=5432

AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=change_me

# Extraction settings (optional)
USGS_START_DATE=2026-01-01
USGS_MIN_MAGNITUDE=4.5
USGS_LIMIT=1000
EONET_START_DATE=2026-01-01
EONET_LIMIT=500
GDACS_START_DATE=2026-01-01
# One request per type, 60 s apart (robots.txt)
GDACS_EVENT_TYPES=EQ;TC;FL;VO;DR;WF
# ReliefWeb API: appname must be approved by ReliefWeb first (https://apidoc.reliefweb.int/).
# Leave empty until approved -> the reliefweb_api source is skipped (not failed).
RELIEFWEB_APPNAME=
RELIEFWEB_START_DATE=2025-01-01
# Identify yourself to the APIs (put a contact email for your team here)
SCRAPER_USER_AGENT=GlobalDisasterDashboard/1.0 (student educational project; non-commercial)
